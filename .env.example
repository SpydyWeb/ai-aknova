# Settings for the live server (npm start). Copy this file to .env on the host and fill it in,
# or enter the same names in your host's "environment variables" screen.

# What you sign in to /admin with. Use a long password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Where the admin panel keeps site.json, uploads and backups. Point this at a folder OUTSIDE the
# app folder so that redeploying the code never overwrites your content. Leave empty to use ./content.
CONTENT_DIR=

# The port to listen on. Most hosts set this for you.
# PORT=3000

# Only for building locally: a Web3Forms key can also be pasted in the admin panel instead.
VITE_WEB3FORMS_KEY=
